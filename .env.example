# =============================================================================
# Recall AI — Environment Configuration Template
# Copy this file to .env before starting the application:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Application Mode
# -----------------------------------------------------------------------------
# Choose: "development", "test", or "production"
ENVIRONMENT=production

# Set to "false" in production to prevent traceback leaks in API error responses
DEBUG=false

# -----------------------------------------------------------------------------
# 2. Server Secrets (DO NOT COMMIT OR EXPOSE TO FRONTEND)
# -----------------------------------------------------------------------------
# Master secret for signing JWT auth tokens. Must be >= 32 characters.
# Generate with: openssl rand -base64 32
SECRET_KEY=replace_with_a_secure_random_32_plus_character_secret_key!

# Access token lifespan in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 32-byte (64 hex characters) key for AES-256-GCM BYOK credential encryption vault.
# Generate with: openssl rand -hex 32
BYOK_ENCRYPTION_KEY=replace_with_exact_64_character_hex_key_e_g_0123456789abcdef...

# -----------------------------------------------------------------------------
# 3. Database & pgvector Configuration
# -----------------------------------------------------------------------------
# Database user and credentials for containerized PostgreSQL + pgvector
POSTGRES_USER=recall
POSTGRES_PASSWORD=replace_with_strong_database_password
POSTGRES_DB=recall

# Full SQLAlchemy / database connection URL.
# If left empty, Recall AI automatically defaults to local persistent SQLite.
DATABASE_URL=postgresql://recall:replace_with_strong_database_password@postgres:5432/recall

# -----------------------------------------------------------------------------
# 4. Networking & CORS
# -----------------------------------------------------------------------------
# Allowed CORS origins for browser security (comma-separated, no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://yourdomain.com

# Gateway exposed port
PORT=80

# -----------------------------------------------------------------------------
# 5. Persistent Storage Paths
# -----------------------------------------------------------------------------
# Internal container paths for SQLite state and uploaded PDF files
DATA_DIR=/app/data
UPLOAD_DIR=/app/uploads

# -----------------------------------------------------------------------------
# 6. AI Providers & Inference Configuration
# -----------------------------------------------------------------------------
# Primary default provider: "openai", "gemini", "groq", or "ollama"
# Note: Users can override this per-account with their own BYOK keys in Settings.
LLM_PROVIDER=openai

# OpenAI Configuration (Optional server fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Google Gemini Configuration (Optional server fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Groq Configuration (Optional server fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama Configuration (if using local-ai profile)
OLLAMA_HOST=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# -----------------------------------------------------------------------------
# 7. Optional LLM Observability & Tracing (Langfuse)
# -----------------------------------------------------------------------------
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# -----------------------------------------------------------------------------
# 8. Optional Remote Cloud Sync (Supabase)
# -----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
